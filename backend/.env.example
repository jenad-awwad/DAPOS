# Railway PostgreSQL — use DATABASE_PUBLIC_URL locally, DATABASE_URL on Railway
DATABASE_URL="postgresql://postgres:password@hostname.proxy.rlwy.net:PORT/railway"

# Required in production
JWT_SECRET="change-this-to-a-long-random-string"

# Server port (Railway sets PORT automatically)
PORT=3000

# S3-compatible object storage (R2, AWS S3, MinIO) for vendor attachments
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional public CDN base URL (otherwise presigned GET URLs are returned)
S3_PUBLIC_BASE_URL=

# Public API origin used for local attachment URLs (defaults to this request origin)
PUBLIC_API_URL=
